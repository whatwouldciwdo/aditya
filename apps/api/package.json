{
  "name": "@aditya/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "cross-env API_PORT=3131 tsx watch src/main.ts",
